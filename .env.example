# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
SHUTDOWN_TIMEOUT_SECS=30

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://umurinzi:secret@localhost:5432/umurinzi?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINS=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=Jwtsecretkey
JWT_EXPIRY_HOURS=24
BCRYPT_COST=12

# ── Anomaly Detection ─────────────────────────────────────────────────────────
ANOMALY_STATIONARY_MINUTES=5
ANOMALY_DEVIATION_METERS=300
ANOMALY_PANIC_BUFFER_SIZE=30

# ── Two-Tier Matching Engine ──────────────────────────────────────────────────
# Self-hosted OSRM instance. Run with the Rwanda road network extract.
# docker run -t -v $(pwd)/osrm-data:/data ghcr.io/project-osrm/osrm-backend \
#   osrm-routed --algorithm mld /data/rwanda-latest.osrm
OSRM_BASE_URL=http://localhost:5000

# Dynamic scoring: score = (ETA_min × W_time) + (road_km × W_distance)
# Lower score = better. Default weights heavily favour speed over distance.
MATCH_WEIGHT_TIME=3.0
MATCH_WEIGHT_DISTANCE=1.0

# Batching: hold new orders in Redis for this long before matching.
# Prevents top-rated drivers absorbing all orders (starvation prevention).
MATCH_BATCH_WINDOW_MS=12000

# Tier-1 Redis GEOSEARCH radius per vehicle class (coarse haversine filter).
# Motorcycles bubble is smaller — prevents expensive deadheading for low fares.
MATCH_RADIUS_MOTORCYCLE_KM=3.0
MATCH_RADIUS_CAR_KM=5.0
MATCH_RADIUS_VAN_KM=7.0
MATCH_RADIUS_TRUCK_KM=10.0

# Maximum road distance a driver may travel to reach the pickup point.
# If OSRM reports a deadhead distance above this, the driver is skipped.
MATCH_MAX_DEADHEAD_MOTORCYCLE_KM=3.0
MATCH_MAX_DEADHEAD_CAR_KM=6.0
MATCH_MAX_DEADHEAD_VAN_KM=10.0
MATCH_MAX_DEADHEAD_TRUCK_KM=15.0

# Highway-passing paradox fix: penalise drivers moving fast away from pickup.
# If bearing diff > threshold AND speed > min_speed, score is multiplied.
MATCH_HEADING_PENALTY_THRESHOLD_DEG=90.0
MATCH_HEADING_PENALTY_MIN_SPEED_KMH=30.0
MATCH_HEADING_PENALTY_MULTIPLIER=1.8

# OSRM HTTP request timeout.
OSRM_TIMEOUT_MS=3000
